# ─────────────────────────────────────────────────────────────
# Studio Doer environment
# Auto-generated by Forseti — copy to .env and fill in the empty values.
# Never commit .env (already in .gitignore).
# ─────────────────────────────────────────────────────────────

# ── LLM provider credential (Zero Trust ZT-1) — NOT required to boot ──
# This skeleton ships with 0 bound models (capability_truth
# ai_bound: 0): the runtime boots without a key and blocking stubs fail
# safe. Provide the key when you bind a model. Anthropic Claude is the
# default provider (src/shared/llm_client.py).
# Server-side only. NEVER expose to client code or commit to VCS (HexaBox doctrine).
#
# ZERO TRUST (ZT-1): do NOT ship a static long-lived API key in code or
# config. In production, inject a short-lived credential from your secrets
# manager / token broker at runtime (Vault, AWS/GCP/Azure secret manager,
# or an OIDC token-exchange endpoint). src/shared/credentials.py resolves
# the credential through that seam — set ANTHROPIC_TOKEN_ENDPOINT to a
# broker that mints a fresh token per request and the static key below is
# never read. Leave ANTHROPIC_API_KEY blank in every non-dev environment.
#
# Refresh/rotation: the runtime re-fetches from the token endpoint when the
# cached credential nears expiry (ANTHROPIC_TOKEN_TTL_SECONDS).
#
# Server-side only. Leave blank unless a secrets manager injects it; the
# token endpoint above takes precedence. Never reaches client code.
ANTHROPIC_API_KEY=
# ANTHROPIC_TOKEN_ENDPOINT=https://secrets.internal.example.com/token/anthropic
# ANTHROPIC_TOKEN_TTL_SECONDS=900
#
# dev-only fallback (LOCAL DEVELOPMENT ONLY — never commit a real value,
# never set this in staging/production; the token endpoint above wins):
ANTHROPIC_API_KEY_DEV=

# ── Models (optional overrides) ───────────────────────────────
# Per-node model overrides. Sensible defaults are baked into the
# handlers; only set these if you want to pin a specific model
# (e.g. cheaper Haiku for triage, Sonnet for analysis).
# ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
# ANTHROPIC_MODEL_TRIAGE=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-4-6
# ANTHROPIC_MODEL_REPORT=claude-sonnet-4-6

# ── Runtime ───────────────────────────────────────────────────
LOG_LEVEL=info

# Comma-separated list of CORS allowed origins for /healthz +
# /<node>/port-xi endpoints. Safe-by-default: local dev origins only.
# Widen deliberately per deploy (e.g. https://app.example.com) —
# never use '*' in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Barrier-sync timeout (ms). Egress.XI waits for all upstream HBs
# to deliver inputs; if any branch is slower than this, the
# request fails fast. Increase for slow LLM nodes.
BARRIER_TIMEOUT_MS=120000

# ── Reference capability (Fas 2.16 — test harness, NEVER production) ──
# DOER_REFERENCE_MODE=1 makes unimplemented CUSTOMER_SLOTs return
# CONTRACT-DERIVED reference outputs (marked "reference": true) and the
# privileged gate perform a side-effect-free reference execution — proving
# the chassis runs the full happy path through the action gate. It is NOT
# domain logic. Approval provenance stays fully enforced (signed,
# action-bound approvals required for gated tiers). Default OFF.
# Leave unset in every real deployment.
# DOER_REFERENCE_MODE=1

# ── Runtime mode (runtime_mode delivery flag) — DISCLOSED posture ─────
# This build was generated in runtime_mode = "reference"
# (src/shared/runtime_mode.py; also in module_truth.json + signed
# conformance). HEXABOX_RUNTIME_MODE overrides it at runtime:
#   reference = fail-closed skeleton; the opt-in reference harness above
#               may emit disclosed-synthetic outputs (today's default).
#   live      = expects REAL capability bindings; the reference harness is
#               REFUSED so unbound capabilities fail closed (never synthetic).
# HEXABOX_RUNTIME_MODE=reference

# ── Strict contract enforcement (Fas 2.24b — DEFAULT ON) ─────────────
# Every node's OUTPUT payload + canonical envelope is validated against
# its generated port contract (src/shared/contracts.py) on every emit.
# This is the fail-closed DEFAULT — a declared contract is an enforced
# contract — consistent with CCAS, audit and ingress auth. The explicit
# opt-out below is for development/experimentation ONLY; never ship a
# deployment with it.
# DOER_STRICT_CONTRACTS=0

# ── Audit chain (H7) ──────────────────────────────────────────
# HexaRecord append-only audit log. Default = filesystem; swap to
# DATABASE_URL for production (Postgres + pgvector recommended).
# Fas 3.32 — these are DELIBERATELY commented out, and must stay that way.
# deploy/docker-compose.yml loads this file via env_file: ../.env, and the
# documented quickstart is cp .env.example .env. An UNCOMMENTED relative
# value here therefore OVERRIDES the Dockerfile's container-correct
# /app/state/... value and points the audit chain at the root-owned WORKDIR,
# which the non-root doer cannot write. /readyz then returns 503 forever and
# the container never becomes healthy. The code defaults (relative) already
# cover local dev and pytest, where no .env is loaded — so setting them here
# buys nothing and breaks the container. Uncomment ONLY to redirect state on
# a host where you own the paths.
# HEXA_RECORD_PATH=./hexa_record.jsonl
# DATABASE_URL=postgresql://user:pass@host:5432/hexabox

# ── HexaBox audit egress (optional) ───────────────────────────
# If set, the runtime POSTs ceve_validation reports to a central
# HexaBox API for fleet-wide visibility. Leave blank to keep
# everything local.
# HEXABOX_API_URL=https://api.hexabox.example.com
# HEXABOX_API_KEY=

# ── Transport (input_model.profile = request-response-v1, type = https) ─
# Empty value = must be provided per environment; no defaults are baked in.
ENDPOINT=
AUTH_HEADER=
TIMEOUT_SECONDS=

# ── Zero Trust transport auth (A3, Fas 2.5 — FAIL-CLOSED) ─────
# ZT_REQUIRE_AUTH: default (unset) is ON — a security product never
# boots open by omission. Every non-health endpoint requires a
# verified bearer credential; /healthz stays open for probes.
# Set =0 ONLY for local development — the serve-guard in src/main.py
# then refuses any non-loopback bind. See docs/deployment-tls.md.
# ZT_REQUIRE_AUTH=1
#
# Identity map (JSON): token -> identity + scopes (+ expires_at).
# Scopes used by the runtime: events:write, incidents:read,
# audit:read, autonomy:read.
# ZT_IDENTITIES={"<token>":{"identity":"ops@example.com","scopes":["events:write","incidents:read","audit:read","autonomy:read"],"expires_at":null}}
#
# Optional mTLS subject mapping behind a TLS-terminating proxy that
# OVERWRITES the subject header (docs/deployment-tls.md):
# ZT_MTLS_ENABLED=0
# ZT_MTLS_IDENTITIES={"CN=analyst-1,O=Example":{"identity":"analyst-1","scopes":["events:write"]}}
# ZT_MTLS_SUBJECT_HEADER=x-client-cert-subject
#
# Bind host for python -m src.main (serve-guard enforces loopback
# when ZT_REQUIRE_AUTH=0):
# BIND_HOST=0.0.0.0

# ── Cohort HMAC secret (MO boundary, Fas 2.9i) ────────────────
# Tenant k-anonymity counts DISTINCT tenants via
# tenant_cohort_key = HMAC-SHA256(secret, tenant_id).
# PRODUCTION REQUIREMENT: the secret MUST be persistent and
# consistent across restarts/replicas — otherwise pseudonyms
# change and the same tenant is re-counted as new, breaking
# k-count continuity. Provide it from your secret manager:
# COHORT_HMAC_SECRET=<from secret manager>
# Dev fallback (when unset): a key file is generated ONCE next to
# the cohort store (0600). In containers, keep BOTH the store and
# the key file on the SAME durable volume (COHORT_STORE_PATH):
# COHORT_STORE_PATH=/data/cohort_store.jsonl

# ── Fleet trust plane + transport (blocker B1, closed fleet loop) ──
# A fleet-MANAGED member (signed identity carries owner.fleet_id) refuses
# every privileged action until it holds a coordinator-signed capability
# lease. The lease is obtained OVER THE WIRE: the member signs its
# k-anonymous egress release (FleetSignal/v1), transports it to the
# coordinator (MacroHub), and installs the returned lease for ccas_decide.
# Member-side (every specialist):
# FLEET_MEMBER_KEY=ed25519:<64-hex seed>        # signs this member's FleetSignal (registry holds the pubkey)
# FLEET_MEMBER_REGISTRY=/fleet/fleet_member_registry.json   # signed registry projection (read-only mount)
# FLEET_MANIFEST_PATH=/fleet/fleet_manifest.json          # binds the registry to the SIGNED fleet manifest
# FLEET_MANIFEST_PUBKEY=<64-hex>                # EXTERNAL pin of the manifest signer (out-of-band)
#   WS-1: for a fleet-managed member the manifest AND the pin are MANDATORY —
#   no pin = no registry (never opt-in); durable FLEET_SEQ_PATH/FLEET_REPLAY_PATH
#   are required too (image defaults them under /app/state/fleet).
# FLEET_SEQ_PATH=/app/state/fleet/seq            # durable producer sequence (never replays after restart)
# FLEET_LEASE_PATH=/app/state/fleet/lease.json   # where the verified coordinator lease is installed
# FLEET_COORDINATOR_URL=https://macrohub:8443     # the coordinator runtime (https by default)
# FLEET_COORDINATOR_TOKEN=<bearer>                # maps to a ZT identity with events:write ON THE COORDINATOR
# FLEET_TLS_CA_FILE=/fleet/tls/ca.pem             # PINNED CA that signed the coordinator server certificate
# FLEET_TLS_CLIENT_CERT_FILE=/fleet/tls/member-client.pem   # mutual TLS (client certificate)
# FLEET_TLS_CLIENT_KEY_FILE=/fleet/tls/member-client.key
# FLEET_TRANSPORT_TIMEOUT_S=5
# FLEET_TRANSPORT_ALLOW_PLAINTEXT=0   # 1 = explicit DEV opt-out for http:// (never a production posture)
# Coordinator-side (MacroHub) additionally:
# FLEET_LEASE_SIGNING_KEY=ed25519:<64-hex seed>   # PRIVATE lease key — coordinator ONLY, never on a member
# FLEET_REPLAY_PATH=/app/state/fleet/replay.json  # durable per-member replay/sequence high-water
# FLEET_POSTURE=normal                            # lease TTL posture (normal|elevated|lockdown)
# Serve TLS ITSELF (both sides; no proxy needed between fleet containers):
# TLS_CERT_FILE=/fleet/tls/<this>-server.pem
# TLS_KEY_FILE=/fleet/tls/<this>-server.key
# TLS_CLIENT_CA_FILE=/fleet/tls/ca.pem   # when set, a client certificate is REQUIRED (mutual TLS)
# See docs/fleet-transport.md for the full wiring and the cross-container E2E.

# ── Service identity ──────────────────────────────────────────
# RESERVED — not read by the current runtime. Kept for operators
# who tag logs/metrics per service in their own tooling.
SERVICE_NAME=forseti_hexaforge_slm_training_master_agent
