# Production:
#   docker pull ghcr.io/<owner>/<repo>:latest
#   docker run -d -p 8000:8000 --env-file /etc/doer/.env <image>

# Supply-chain (Fas 2.18): BASE_IMAGE defaults to the digest the FACTORY measured
# (embedded at generation, so the pin ships SIGNED in this Dockerfile); it falls
# back to the floating tag only until the factory CI has measured the registry
# digest (the edge generator cannot reach the registry). Override per build with
# --build-arg BASE_IMAGE=... . deploy/base-image.lock carries the same ref for
# build-image.yml / compose.
ARG BASE_IMAGE=python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

# ===================== Stage 1 — builder =====================
FROM ${BASE_IMAGE} AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# Fas 2.18 — requirements.lock is measured before export and BORN IN this bundle
# (SIGNED in the manifest), so it is always present: copy it explicitly (no glob
# fallback) and install hash-locked, unconditionally.
COPY pyproject.toml requirements.lock ./
COPY src/ ./src/
COPY runtime/ ./runtime/
COPY karta.yaml karta.compiled.json ./
COPY contracts/ ./contracts/

# Fas 2.18 — hash-locked install, no unpinned path. pip refuses any artifact whose
# sha256 is not in the born-in lock (--require-hashes covers the FULL transitive
# closure), and the project itself is added with --no-deps so nothing is resolved
# outside the lock. anthropic, httpx and pytest are declared in pyproject.toml —
# no bare, unpinned named-package installs (Fas 2.14a).
# Fas 3.4 (external DD) - an unpinned pip upgrade resolved a FLOATING
# version at build time while the gate's own name claimed "no unpinned pip
# installs". The claim is now true: pip/setuptools/wheel are version-pinned like
# every other dependency, so the build tool chain is as pinned as the tree it
# installs. Bump them like any other pin (Dependabot covers pip).
RUN pip install --no-cache-dir pip==24.2 setuptools==75.1.0 wheel==0.44.0 \
 && pip install --require-hashes --no-deps -r requirements.lock \
 && pip install --no-deps -e .

# Tests + validator copied for in-container debug (CI gates pytest separately)
COPY tests/ ./tests/
COPY validator/ ./validator/

# ===================== Stage 2 — runtime =====================
FROM ${BASE_IMAGE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

RUN groupadd --system doer \
 && useradd --system --gid doer --create-home --home-dir /home/doer doer

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY --chown=doer:doer src/ ./src/
COPY --chown=doer:doer runtime/ ./runtime/
COPY --chown=doer:doer karta.yaml karta.compiled.json pyproject.toml ./
COPY --chown=doer:doer contracts/ ./contracts/
# Signed conformance evidence must travel with the running image.
COPY --chown=doer:doer reports/ ./reports/
COPY --chown=doer:doer identity.json PROVENANCE.json ./

# Fas 2.25 (external DD, Peter #7) — a DOER-WRITABLE state dir. WORKDIR /app is
# root-owned, so 'doer' cannot create ./hexa_record.jsonl there: the first event
# would PermissionError while /healthz stayed green (healthy-but-broken). The
# audit chain, approvals ledger and LLM-provenance log live in /app/state, owned
# by doer and declared a VOLUME so it stays writable even under a read-only root
# filesystem (k8s readOnlyRootFilesystem: true) once a volume is mounted here.
RUN mkdir -p /app/state && chown doer:doer /app/state
VOLUME ["/app/state"]

USER doer

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request, sys; \
    r = urllib.request.urlopen('http://localhost:8000/healthz', timeout=3); \
    sys.exit(0 if r.status == 200 else 1)"

ENV PYTHONPATH=/app
# Fas 2.25 — point the runtime's writable state at the doer-owned /app/state
# volume (see the RUN mkdir above). These are the container defaults; the code
# defaults stay relative for local/dev + tests. /readyz proves this dir is
# actually writable before the orchestrator routes traffic.
ENV HEXA_STATE_DIR=/app/state \
    DOER_STATE_ROOT=/app/state \
    HEXA_RECORD_PATH=/app/state/hexa_record.jsonl \
    HEXA_SOURCE_PATH=/app/state/hexa_source.jsonl \
    CCAS_LEDGER_PATH=/app/state/ccas_approvals.jsonl \
    EXECUTION_LEDGER_PATH=/app/state/execution_ledger.jsonl \
    FLEET_REPLAY_PATH=/app/state/fleet/replay.json \
    FLEET_SEQ_PATH=/app/state/fleet/seq
# WS-1 (B2): a fleet-managed runtime REFUSES to sign without a durable sequence
# path and refuses every fleet signal without durable replay state — so the
# image defaults both under the doer-owned state volume. Never point them at an
# ephemeral location in production.
# Fas 2.5 (A3): the F1 FastAPI bridge (runtime.api_server:app) is served via
# the GUARDED entrypoint runtime/serve.py — an auth-off (ZT_REQUIRE_AUTH=0)
# container refuses non-loopback binds instead of serving open endpoints.
# Fail-closed default: unset => auth ON. docker-compose's admin-ui service
# overrides this to run runtime/orchestrator.py on port 8080.
CMD ["python", "-m", "runtime.serve"]
