    ]
  },
  "mo": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "hexaforge_slm_training_master_egress_octa.mo",
    "type": "object",
    "schema_type": "object",
    "schema_version": "1.0.0",
    "properties": {
      "schema_version": {
        "type": "string",
        "const": "fleet_signal/v1",
        "description": "FleetSignal envelope version"
      },
      "event_type": {
        "type": "string",
        "description": "classification of the signal"
      },
      "vertical": {
        "type": "string"
      },
      "aggregate_payload": {
        "type": "object",
        "description": "k-anonymized aggregate"
      },
      "k_count": {
        "type": "integer",
        "minimum": 5,
        "description": "distinct tenants observed; must be >= 5"
      },
      "cycle_id": {
        "type": "string",
        "description": "N6 cohort-cycle correlation id"
      },
      "window_start": {
        "type": "string",
        "description": "aggregation window start (ISO 8601)"
      },
      "window_end": {
        "type": "string",
        "description": "aggregation window end (ISO 8601)"
      },
      "member_agent_id": {
        "type": "string",
        "description": "sending member agent id — must exist in the signed fleet member registry"
      },
      "karta_hash": {
        "type": "string",
        "description": "sha256 of the member compiled karta — must match the registry binding"
      },
      "doctrine_version": {
        "type": "string",
        "description": "member doctrine/ruleset version — must match the fleet doctrine"
      },
      "evidence": {
        "type": "object",
        "description": "FleetEvidence/v1 — the authority-bearing conformance the coordinator attests (CEVE verdict/score, degraded, action rate, approval provenance), bound to the signature via evidence_digest.",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "fleet_evidence/v1"
          },
          "ceve_verdict": {
            "type": "string",
            "description": "the member's own CEVE verdict (PASS/FAIL)"
          },
          "ceve_score": {
            "type": "integer",
            "description": "the member's own CEVE score (0-100)"
          },
          "degraded": {
            "type": "boolean",
            "description": "true when the member is running degraded (no bound SLM / hash-stub embeddings)"
          },
          "action_rate": {
            "type": [
              "number",
              "null"
            ],
            "description": "observed privileged-action rate (drift signal)"
          },
          "approval_provenance": {
            "type": [
              "string",
              "null"
            ],
            "description": "approval-provenance health (ok/healthy/failing)"
          },
          "karta_hash": {
            "type": "string"
          },
          "doctrine_version": {
            "type": "string"
          }
        }
      },
      "evidence_digest": {
        "type": "string",
        "description": "sha256 of the canonical FleetEvidence/v1 object; a SIGNED field, so tampering the evidence breaks the signature."
      },
      "sequence": {
        "type": "integer",
        "minimum": 0,
        "description": "per-member monotonic counter (replay protection)"
      },
      "nonce": {
        "type": "string",
        "description": "unique per envelope (replay protection inside the freshness window)"
      },
      "emitted_at": {
        "type": "string",
        "description": "ISO 8601 emission timestamp (freshness window)"
      },
      "sig": {
        "type": "string",
        "description": "Ed25519 signature (hex) over the canonical signed fields; verified against the member pubkey in the fleet registry"
      }
    },
    "required": [
      "schema_version",
      "event_type",
      "vertical",
      "aggregate_payload",
      "k_count",
      "cycle_id",
      "window_start",
      "window_end",
      "member_agent_id",
      "karta_hash",
      "doctrine_version",
      "evidence",
      "evidence_digest",
      "sequence",
      "nonce",
      "emitted_at",
      "sig"
    ],
    "anonymization_contract": {
      "k_minimum": 5,
      "geographic_scope": {
        "regions": [
          "EU"
        ],
        "data_residency": "eu-west",
        "cross_border_transfer": false
      },
      "retention_policy": {
        "duration_days": 90,
        "deletion_method": "logical_purge_on_write",
        "archive_required": false
      },
      "aggregated_fields": [
        "vertical",
        "event_type"
      ],
      "k_anonymized_fields": [
        "vertical",
        "event_type"
      ]
    }
  }
}